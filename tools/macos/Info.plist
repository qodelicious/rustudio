<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>rustudio</string>
	<key>CFBundleExecutable</key>
	<string>rustudio</string>
	<key>CFBundleIconFile</key>
	<string>rustudio</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.rippelz.rustudio</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>rustudio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT OR Apache-2.0. Not affiliated with Roblox Corporation.</string>
	<!-- Places and models open in rustudio from Finder ("Open With"); an
	     installed Roblox Studio stays the default (Alternate rank). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Roblox Place</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.Roblox.RobloxStudio-document</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Roblox Model</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.rippelz.rustudio.model</string>
			</array>
		</dict>
	</array>
	<!-- Roblox Studio's own place type (the same identifier, so either
	     declaration describes the same files). -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.Roblox.RobloxStudio-document</string>
			<key>UTTypeDescription</key>
			<string>Roblox Place</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rbxl</string>
					<string>rbxlx</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.rippelz.rustudio.model</string>
			<key>UTTypeDescription</key>
			<string>Roblox Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rbxm</string>
					<string>rbxmx</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
